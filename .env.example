# ==============================================================================
# GitLab Unified Platform v2 - Environment Configuration Example
# ==============================================================================

# Server & Network Configuration
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
RUST_LOG=info,gitlab_platform=debug
FRONTEND_DIST=frontend/dist

# Database Configuration (SQLite)
DATABASE_URL=sqlite://data/platform.db?mode=rwc

# Ingestion Scheduler
SYNC_INTERVAL_SECS=300

# GitLab Instance & Root Groups (format: "group1:pat1,group2:pat2")
GITLAB_DOMAIN=https://gitlab.com
GITLAB_ROOT_GROUPS="org/cohort-a:glpat-aaa,org/cohort-b:glpat-bbb"

# Project Timeline & Sprint Parameters
PROJECT_START_DATE=2024-09-01
PROJECT_END_DATE=2025-06-30
SPRINT_START_WEEKDAY=Monday
SPRINT_DURATION_WEEKS=1

# GitLab OAuth 2.0 PKCE Configuration (Required for user login & write operations)
GITLAB_OAUTH_CLIENT_ID=your-gitlab-oauth-app-client-id
GITLAB_OAUTH_CLIENT_SECRET=your-gitlab-oauth-app-client-secret
GITLAB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=generate-a-secure-random-32-byte-hex-or-base64-secret-key-here
